# Build context: apps/lavperform-app
# (EasyPanel: Base Directory = apps/lavperform-app)

FROM node:22-alpine AS builder

WORKDIR /app

# EasyPanel envia VITE_ENVIRONMENT; o código Vite lê VITE_ENVIROMENT (typo legado)
ARG VITE_ENVIRONMENT
ARG VITE_ENVIROMENT=production
ARG VITE_API_URL
ARG VITE_THEME_ID=default
ARG VITE_ADM_DOMAIN
ARG VITE_PRO_URL
ARG VITE_LOGIN_LEFT_IMAGE
ARG VITE_USE_TANSTACK_LOGGER

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_THEME_ID=$VITE_THEME_ID
ENV VITE_ADM_DOMAIN=$VITE_ADM_DOMAIN
ENV VITE_PRO_URL=$VITE_PRO_URL
ENV VITE_LOGIN_LEFT_IMAGE=$VITE_LOGIN_LEFT_IMAGE
ENV VITE_USE_TANSTACK_LOGGER=$VITE_USE_TANSTACK_LOGGER

COPY package.json ./

RUN npm install

COPY . .

RUN VITE_ENVIROMENT="${VITE_ENVIRONMENT:-$VITE_ENVIROMENT}" npm run build

FROM node:22-alpine

WORKDIR /app

RUN npm install -g serve

COPY --from=builder /app/dist ./dist

EXPOSE 3030

CMD ["serve", "-s", "dist", "-l", "3030"]
