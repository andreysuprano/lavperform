# LavPerform API — exemplo de variáveis (não commitar secrets reais)

WHITELABEL=lavperform
ENVIRONMENT=development
PORT=3005
ADMIN_PORT=3001
PUBLIC_API_PORT=3003

DATABASE_URL=postgresql://lavperform:lavperform@localhost:5432/lavperform?schema=public
DATABASE_POOL_MAX=10

JWT_SECRET=change-me
JWT_EXPIRES_IN=7
ADMIN_JWT_SECRET=change-me-admin
ADMIN_JWT_EXPIRES_IN=1

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
BULL_BOARD_PASSWORD=admin

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

WEBHOOK_URL=http://localhost:3005/whatsapp/webhook
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
UAZAPI_API_URL=
UAZAPI_ADMIN_API_KEY=
# Token de fallback para /chat/check quando o pool de instâncias conectadas estiver vazio
# UAZAPI_TOKEN=
# QUEUE_CONCURRENCY_WHATSAPP_VALIDATION=5
# WHATSAPP_VERIFICATION_TTL_DAYS=30

ASAAS_BASE_URL=
ASAAS_API_KEY=

OPENAI_URL=
OVER_AGENT_BASE_URL=

# Posts de redes sociais — único provedor de IA desta feature (texto e imagem).
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Fallback quando o painel admin não salvou um modelo, ou o modelo salvo deixou de existir.
# A escolha do admin fica em ai_model_settings e vale sem novo deploy (cache curto).
# Opcional. Padrão: google/gemini-2.5-flash (chamado via OpenRouter, sem SDK de outro provedor)
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
# Opcional. Padrão: google/gemini-2.5-flash-image
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
# Opcional. Tempo em ms para reler a escolha salva. Padrão: 15000
# AI_MODEL_SETTINGS_CACHE_MS=15000
# Opcional. Header HTTP-Referer enviado ao OpenRouter
OPENROUTER_HTTP_REFERER=https://lavperform.com
# Opcional. Tempo máximo de cada chamada, em ms. Padrão: 90000
OPENROUTER_TIMEOUT_MS=90000

# Imagem de fundo da Social Media. Texto continua só na OpenRouter.
# SOCIAL_IMAGE_PROVIDER=openrouter (padrão) ou fal.
# O fal só é usado com SOCIAL_IMAGE_PROVIDER=fal e FAL_KEY definida.
# Sem a chave, ou se a fila falhar, a imagem volta para a OpenRouter.
# SOCIAL_IMAGE_PROVIDER=openrouter
# https://fal.ai/dashboard/keys
# A chave fica só no servidor: não vai para o app, para logs nem para erros.
FAL_KEY=
# Opcional. Endpoint text-to-image do fal. Padrão: fal-ai/flux-pro/v1.1
# FAL_IMAGE_MODEL=fal-ai/flux-pro/v1.1
# Opcional. Tempo máximo da fila, em ms. Padrão: 90000
# FAL_TIMEOUT_MS=90000
# Opcional. Intervalo entre consultas da fila, em ms. Padrão: 1000
# FAL_POLL_INTERVAL_MS=1000
# Chave compartilhada com o motor. Header X-Internal-Api-Key do MCP de persona dos agentes públicos.
MCP_PUBLIC_AGENTS_API_KEY=
# URL pública do lavai-agent usada ao registrar webhook na UAZAPI
# (ex.: https://development-lav-ai.eefvku.easypanel.host)
LAVAI_AGENT_WEBHOOK_BASE_URL=

VMLAV_API_URL=
CICCLO_API_URL=
MAXLAV_API_URL=
L2AUTOMATE_API_URL=
SALES_IMPORT_ALERT_EMAIL=bruno.saibert@overgroup.com.br

META_APP_ID=
META_APP_SECRET=
# URI exata cadastrada no app Meta. Se vazia, a API usa ${API_PUBLIC_URL}/social-publishing/oauth/meta/callback
META_OAUTH_REDIRECT_URI=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URI exata cadastrada no Google Cloud (Business Profile e Ads usam a mesma).
# Se vazia, a API usa ${API_PUBLIC_URL}/social-publishing/oauth/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_ADS_DEVELOPER_TOKEN=
# URL pública da API e do app, sem barra no final. Obrigatórias para o OAuth real.
API_PUBLIC_URL=
APP_PUBLIC_URL=
# Origens do browser autorizadas a chamar a API com credenciais.
# Lista separada por vírgula. Não use *: com credentials a origem precisa ser explícita.
# Se a variável estiver vazia, a API usa https://app.lavperform.cloud.
# Este arquivo não traz a origem do app de homologação; nesse ambiente, acrescente-a na lista.
# No ambiente local, inclua também http://localhost:8080.
CORS_ORIGIN=https://app.lavperform.cloud
# true liga o modo de teste: OAuth, publicação, avaliações e métricas fictícias, sem credencial real.
INTEGRATIONS_SANDBOX=
# Opcional. Sem ela, os tokens usam JWT_SECRET.
INTEGRATIONS_TOKEN_SECRET=

DISPARO_PRO_BASE_URL=https://apihttp.disparopro.com.br
DISPARO_PRO_API_TOKEN=
DISPARO_PRO_RCS_BASE_URL=https://gateway.disparopro.com.br/rcs
DISPARO_PRO_RCS_API_TOKEN=
DISPARO_PRO_WEBHOOK_SECRET=
