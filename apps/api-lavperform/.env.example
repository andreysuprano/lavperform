# LavPerform API — exemplo de variáveis (não commitar secrets reais)

WHITELABEL=lavperform
ENVIRONMENT=development
PORT=3005
ADMIN_PORT=3001
PUBLIC_API_PORT=3003

DATABASE_URL=postgresql://lavperform:lavperform@localhost:5432/lavperform?schema=public
DATABASE_POOL_MAX=10

JWT_SECRET=change-me
JWT_EXPIRES_IN=7
ADMIN_JWT_SECRET=change-me-admin
ADMIN_JWT_EXPIRES_IN=1

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
BULL_BOARD_PASSWORD=admin

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

WEBHOOK_URL=http://localhost:3005/whatsapp/webhook
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
UAZAPI_API_URL=
UAZAPI_ADMIN_API_KEY=
# Token de fallback para /chat/check quando o pool de instâncias conectadas estiver vazio
# UAZAPI_TOKEN=
# QUEUE_CONCURRENCY_WHATSAPP_VALIDATION=5
# WHATSAPP_VERIFICATION_TTL_DAYS=30

ASAAS_BASE_URL=
ASAAS_API_KEY=

OPENAI_URL=
OVER_AGENT_BASE_URL=
# URL pública do lavai-agent usada ao registrar webhook na UAZAPI
# (ex.: https://development-lav-ai.eefvku.easypanel.host)
LAVAI_AGENT_WEBHOOK_BASE_URL=

VMLAV_API_URL=
CICCLO_API_URL=
MAXLAV_API_URL=
L2AUTOMATE_API_URL=

META_APP_ID=
META_APP_SECRET=
