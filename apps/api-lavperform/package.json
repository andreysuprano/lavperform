{
  "name": "@lavperform/api",
  "version": "1.0.150",
  "description": "LavPerform API",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "semgrep": "semgrep --config .semgrep.yml",
    "qa:local": "bash scripts/qa-local.sh",
    "trivy:scan": "bash scripts/trivy-scan.sh",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "script:create-super-admin": "ts-node -r tsconfig-paths/register src/scripts/create-super-admin.ts",
    "start:admin": "nest start --entryFile main-admin",
    "start:admin:dev": "nest start --watch --entryFile main-admin",
    "start:admin:prod": "node dist/main-admin",
    "build:admin": "nest build",
    "start:public-api": "nest start --entryFile main-public-api",
    "start:public-api:dev": "nest start --watch --entryFile main-public-api",
    "start:public-api:prod": "node dist/main-public-api",
    "start:dev:seed": "npm run seed:local && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "seed:local": "ts-node prisma/seed.ts",
    "db:deploy": "npx prisma migrate deploy && npx prisma generate",
    "script:create-landing-pages": "ts-node -r tsconfig-paths/register src/scripts/create-landing-pages-for-existing-companies.ts",
    "script:create-ai-agents": "ts-node -r tsconfig-paths/register src/scripts/create-ai-agents-for-existing-companies.ts",
    "script:create-weather-alerts": "ts-node -r tsconfig-paths/register src/scripts/create-weather-alerts-for-existing-companies.ts",
    "script:validate-whatsapp-customers": "ts-node -r tsconfig-paths/register src/scripts/validate-whatsapp-for-existing-customers.ts",
    "script:delete-customers-without-orders": "ts-node -r tsconfig-paths/register src/scripts/delete-customers-without-orders.ts",
    "script:delete-company": "ts-node -r tsconfig-paths/register src/scripts/delete-company.ts",
    "script:fix-duplicate-display-ids": "ts-node -r tsconfig-paths/register src/scripts/fix-duplicate-display-ids.ts",
    "script:fix-duplicate-orders": "ts-node -r tsconfig-paths/register src/scripts/fix-duplicate-display-ids.ts",
    "script:migrate-landing-pages": "ts-node prisma/scripts/migrate-landing-pages.ts",
    "script:migrate-landing-pages-location": "ts-node scripts/migrate-landing-pages-location.ts",
    "script:reschedule-overdue-messages": "ts-node scripts/reschedule-overdue-messages.ts",
    "script:remove-campaign-sale-attributions": "ts-node scripts/remove-campaign-sale-attributions.ts",
    "script:revert-orphan-credit-topups": "ts-node scripts/revert-orphan-credit-topups.ts",
    "script:replay-webhooks-to-queue": "ts-node -r tsconfig-paths/register scripts/replay-webhooks-to-queue.ts",
    "script:seed-mass-rfv": "ts-node -r tsconfig-paths/register src/scripts/seed-mass-rfv-data.ts",
    "script:auto-configure-rfv": "ts-node -r tsconfig-paths/register src/scripts/auto-configure-rfv-for-existing-companies.ts",
    "script:seed-laundry-from-json": "ts-node -r tsconfig-paths/register src/scripts/seed-laundry-customers-from-json.ts",
    "script:import-laundrykit-history": "ts-node -r tsconfig-paths/register src/scripts/import-laundrykit-order-history.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:unit": "jest --testPathPattern=test/unit",
    "test:e2e": "jest --config test/e2e/jest-e2e.json",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:integration": "jest --config test/integration/jest-integration.config.ts --runInBand --forceExit",
    "test:integration:watch": "jest --config test/integration/jest-integration.config.ts --watch",
    "test:integration:debug": "node --inspect-brk node_modules/.bin/jest --config test/integration/jest-integration.config.ts --runInBand",
    "test:integration:verbose": "jest --config test/integration/jest-integration.config.ts --runInBand --verbose --forceExit"
  },
  "dependencies": {
    "@bull-board/api": "^6.13.0",
    "@bull-board/express": "^6.13.0",
    "@bull-board/nestjs": "^6.13.0",
    "@nestjs/axios": "^4.0.0",
    "@nestjs/bull": "^11.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.14",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.1.1",
    "@prisma/adapter-pg": "^7.0.1",
    "@prisma/client": "^7.0.1",
    "@sentry/nestjs": "^10.5.0",
    "@sentry/profiling-node": "^10.5.0",
    "@types/multer": "^1.4.12",
    "@types/passport-jwt": "^4.0.1",
    "axios": "^1.8.4",
    "bcrypt": "^5.1.1",
    "bull": "^4.16.5",
    "bullmq": "^5.48.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "crypto-browserify": "^0.0.1",
    "dotenv": "^17.2.3",
    "express-basic-auth": "^1.2.1",
    "ioredis": "^5.6.1",
    "luxon": "^3.7.2",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^7.0.6",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.16.3",
    "prisma": "^7.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.9",
    "@pact-foundation/pact": "^16.0.2",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@testcontainers/postgresql": "^11.10.0",
    "@testcontainers/redis": "^11.10.0",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.7.1",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.4",
    "testcontainers": "^11.10.0",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
