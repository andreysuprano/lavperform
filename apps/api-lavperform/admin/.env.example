NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001
NEXT_PUBLIC_BRAND=custom
NEXT_PUBLIC_BRAND_NAME=FoodCRM
# URL pública do painel (Open Graph / preview de links). Fallback: NEXT_PUBLIC_WHATSAPP_CONNECT_BASE_URL
NEXT_PUBLIC_APP_URL=http://localhost:3002
# Origem pública do admin (página /connect/:token). Em produção, use o domínio real do painel.
NEXT_PUBLIC_WHATSAPP_CONNECT_BASE_URL=http://localhost:3002
# Na API admin (Nest), defina a mesma URL para listagens sem o frontend:
# WHATSAPP_CONNECT_BASE_URL=https://admin.seudominio.com.br
