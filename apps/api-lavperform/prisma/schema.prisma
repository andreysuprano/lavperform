  updatedAt    DateTime @updatedAt

  @@index([companyId])
  @@map("company_credit_wallets")
}

model CreditProduct {
  id            String              @id @default(uuid())
  companyId     String
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  code          String
  description   String?
  priceCents    Int
  active        Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  ledgerEntries CreditLedgerEntry[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, active])
  @@index([companyId, deletedAt])
  @@map("credit_products")
}

model DefaultCreditProduct {
  id            String              @id @default(uuid())
  name          String
  code          String              @unique
  description   String?
  priceCents    Int
  active        Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  deletedAt     DateTime?
  ledgerEntries CreditLedgerEntry[]

  @@index([active])
  @@index([deletedAt])
  @@map("default_credit_products")
}

model CreditTopup {
  id                String              @id @default(uuid())
  companyId         String
  company           Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  paymentMethod     CreditPaymentMethod
  status            CreditTopupStatus   @default(PENDING)
  amountCents       Int
  asaasChargeId     String?             @unique
  paidAt            DateTime?
  rawPaymentPayload Json?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  ledgerEntries     CreditLedgerEntry[]

  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([companyId, status])
  @@map("credit_topups")
}

model CreditLedgerEntry {
  id                String                @id @default(uuid())
  companyId         String
  company           Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type              CreditLedgerEntryType
  amountCents       Int
  balanceAfterCents Int
  metadata          Json?
  topupId           String?
  topup             CreditTopup?          @relation(fields: [topupId], references: [id], onDelete: SetNull)
  productId         String?
  product           CreditProduct?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  defaultProductId  String?
  defaultProduct    DefaultCreditProduct? @relation(fields: [defaultProductId], references: [id], onDelete: SetNull)
  createdAt         DateTime              @default(now())

  @@index([companyId])
  @@index([companyId, createdAt])
  @@index([companyId, type])
  @@index([topupId])
  @@index([productId])
  @@index([defaultProductId])
  @@map("credit_ledger_entries")
}

/// Janela de conversão por classificação RFV (dias desde a última mensagem recebida do cliente).
