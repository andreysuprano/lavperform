  rfvClassification String
  thresholdDays     Int      @default(7)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([companyId, rfvClassification])
  @@index([companyId])
  @@map("campaign_conversion_window")
}

enum MetaIntegrationStatus {
  PENDING
  ACTIVE
  ERROR
  REVOKED
}

enum MetaTemplateStatus {
  PENDING
  APPROVED
  REJECTED
  DISABLED
  PAUSED
  IN_APPEAL
  DELETED
  ERROR
}

enum MetaTemplateCategory {
  AUTHENTICATION
  MARKETING
  UTILITY
}

/// Integração com a API oficial do WhatsApp Business (Meta Cloud API).
/// Armazena o token de acesso e os IDs de ativos da Meta necessários para envio de mensagens.
model MetaIntegration {
  id String @id @default(uuid())

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  /// Número de telefone no formato internacional (ex: 5541997269435)
  phoneNumber String

  /// Business Integration System User Access Token obtido via Embedded Signup
  accessToken String

  tokenType String @default("bearer")

  /// ID do número de telefone na Meta (Phone Number ID   usado em todas as chamadas de API)
  phoneNumberId String?

  /// WhatsApp Business Account ID (WABA ID   necessário para gestão de templates, webhooks, etc.)
  wabaId String?

  /// Business Portfolio ID (Meta Business ID)
  businessId String?

  /// Nome de exibição do número de telefone na Meta
  displayName String?

  /// Qualidade do número: GREEN | YELLOW | RED
  qualityRating String?

  /// Limite de mensagens: TIER_50 | TIER_250 | TIER_1K | TIER_10K | TIER_100K | UNLIMITED
  messagingLimitTier String?

  /// Indica se o app foi inscrito nos webhooks da WABA
  webhooksSubscribed Boolean @default(false)

  /// Indica se o número foi registrado no Cloud API
  phoneNumberRegistered Boolean @default(false)

  status MetaIntegrationStatus @default(PENDING)

  /// Última vez que os dados do número foram consultados na Meta API (qualityRating, messagingLimitTier, displayName)
  phoneInfoLastSyncAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wabaId])
  @@index([phoneNumberId])
  @@map("meta_integrations")
}

/// Template de mensagem submetido para aprovação na Meta Cloud API.
/// Cada criativo de campanha automática de API Oficial gera um template.
model MetaMessageTemplate {
  id String @id @default(uuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  automaticCampaignCreativeId String?                    @unique
  automaticCampaignCreative   AutomaticCampaignCreative? @relation(fields: [automaticCampaignCreativeId], references: [id], onDelete: SetNull)

  /// ID retornado pela Meta após submissão do template.
  metaTemplateId String?

  /// Nome técnico enviado à Meta (snake_case, único na conta).
  name       String
  /// Nome amigável exibido no app para identificar o template.
  displayName String?
  language   String               @default("pt_BR")
  category   MetaTemplateCategory @default(MARKETING)
  components Json

  /// URL pública da mídia usada no header (IMAGE/VIDEO/DOCUMENT), preservada
  /// apenas para exibição de prévia no app — a Meta não retorna a URL
  /// original, só um handle opaco (`header_handle`).
  headerMediaUrl String?

  status         MetaTemplateStatus @default(PENDING)
  rejectedReason String?
  qualityScore   Json?

  messages  Message[]
  automaticCampaigns AutomaticCampaign[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([companyId])
  @@index([metaTemplateId])
  @@map("meta_message_templates")
}
