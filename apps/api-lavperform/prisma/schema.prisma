/// Cupom disponível para utilização em campanhas. O código é emitido por uma plataforma externa.
model Coupon {
  id                 String              @id @default(uuid())
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code               String
  description        String?
  type               String
  unit               String
  value              Decimal             @db.Decimal(10, 2)
  validUntil         DateTime
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  deletedAt          DateTime?
  automaticCampaigns AutomaticCampaign[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([companyId, active])
  @@index([companyId, validUntil])
  @@map("coupons")
}

enum CreditPaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  PLATFORM
}

enum CreditTopupStatus {
  PENDING
  PAID
  FAILED
  CANCELED
  EXPIRED
}

enum CreditLedgerEntryType {
  TOPUP
  CONSUMPTION
}

model CompanyCreditWallet {
  id           String   @id @default(uuid())
  companyId    String   @unique
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  balanceCents Int      @default(0)
