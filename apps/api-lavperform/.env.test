# Test Environment Configuration
# This file is used for running integration and e2e tests
# DATABASE_URL and REDIS_* are set dynamically by Testcontainers in jest.globalSetup.ts

# JWT Configuration
JWT_SECRET=test-jwt-secret-key-for-testing-only

# Application Configuration
PORT=3001
NODE_ENV=test

# AI/External Services (mocked in tests)
OPENAI_API_KEY=test-key
ANTHROPIC_API_KEY=test-key

# Over Agent API (agentes de IA via integração externa)
OVER_AGENT_BASE_URL=http://over-agent:3000

# Email Configuration (not used in tests)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
SMTP_FROM=test@example.com

# Feature Flags
ENABLE_AI_FEATURES=false
ENABLE_EMAIL_NOTIFICATIONS=false

# Logging
LOG_LEVEL=error
