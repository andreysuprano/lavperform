{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "watchAssets": true,
    "assets": [
      {
        "include": "generated/prisma/**/*",
        "watchAssets": true
      },
      {
        "include": "application/agent-configurator/prompts/**/*.md",
        "watchAssets": true
      }
    ]
  }
}
