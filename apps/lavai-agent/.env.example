PORT=3000

# CORS — omita ou use * para permitir qualquer origem; ou liste URLs separadas por vírgula
# CORS_ORIGINS=*

# PostgreSQL com pgvector (lavai-db)
DATABASE_URL=postgresql://user:password@host:5432/agentes?schema=public

# Banco LavPerform — usado pelo script sync-lavperform-companies.mjs
# LAVPERFORM_DATABASE_URL=postgresql://user:password@host:5432/lavperform?schema=public

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# OpenAI (Whisper, embeddings)
OPENAI_API_KEY=sk-...

# UAZAPI (WhatsApp)
UAZAPI_API_KEY=
UAZAPI_BASE_URL=https://...

# OpenRouter — gateway para todos os LLMs
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=lavai-agent
OPENROUTER_APP_URL=https://lavperform.com

# Runtime agêntico
AGENT_MAX_TOOL_ITERATIONS=10
AGENT_RAG_TOP_K=5
AGENT_RAG_SIMILARITY_THRESHOLD=0.7

# Buffer de mensagens — agrupa envios rápidos do mesmo chat antes de chamar o LLM
# Tempo em milissegundos de inatividade para disparar o processamento (padrão: 3000ms)
MESSAGE_BUFFER_TIMEOUT_MS=3000

# Intervenção humana — quando o atendente digita manualmente no dispositivo,
# o agente fica em espera por este tempo antes de retomar as respostas automáticas.
# Valor em milissegundos (padrão: 600000 = 10 minutos)
HUMAN_TAKEOVER_TIMEOUT_MS=600000

# Webhook de compra (opcional — se definido, exige header X-Internal-API-Key)
PURCHASE_WEBHOOK_API_KEY=

# Follow-up proativo
FOLLOW_UP_MAX_RETRIES=3
