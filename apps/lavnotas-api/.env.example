# LavNotas — homologação. Sem dados reais de clientes.
NODE_ENV=production
PORT=3040

# Banco exclusivo do LavNotas. Não apontar para o Postgres do LavPerform.
DATABASE_URL=postgresql://lavnotas:lavnotas@localhost:5441/lavnotas

# Redis exclusivo das filas BullMQ do LavNotas.
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_PASSWORD=

# Chave para cifrar o .pfx e a senha do certificado A1 (AES-256-GCM).
# Qualquer segredo com 16+ caracteres. Não commitar o valor real.
CERTIFICATE_ENCRYPTION_KEY=troque-por-um-segredo-longo

# true: ACBr fictício (sucesso, rejeição e indisponibilidade) sem credencial.
# false: sandbox real https://hom.acbr.api.br
ACBR_MOCK=true
ACBR_ENV=homologacao
ACBR_BASE_URL=https://hom.acbr.api.br
ACBR_AUTH_URL=https://auth.acbr.api.br/realms/ACBrAPI/protocol/openid-connect/token
ACBR_CLIENT_ID=
ACBR_CLIENT_SECRET=
ACBR_SCOPES=empresa nfse nfe

# Retentativas da fila quando a ACBr não responde. Backoff exponencial em ms.
QUEUE_MAX_ATTEMPTS=12
QUEUE_BACKOFF_MS=2000
